FINCOMPASS_HOSTED_MODE=1
FINCOMPASS_AUTH_MODE=required
FINCOMPASS_DATA_DIR=/tmp/fincompass
RATE_LIMIT_BACKEND=memory
AUDIT_IP_MODE=none
AUDIT_LOG_ENABLED=0

# Firebase Web app public configuration. These values are identifiers, not secrets.
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_API_KEY=YOUR_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com

# Optional data-source keys. Leave blank when unused.
FRED_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_KEY=
