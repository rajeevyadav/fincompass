# ============================================================
# FinCompass .gitignore — hardened (governance guardrail)
# Never commit secrets, real credentials, or runtime data.
# Synthetic fixtures (datasets/) and the fixture_only model
# (models/) ARE committed on purpose for reproducibility.
# ============================================================

# --- Secrets / credentials — NEVER commit ---
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.keystore
id_rsa
id_ed25519
secrets/
*.credentials
credentials.json

# --- Runtime data / logs (regenerated at run time) ---
data/*.db
data/*.db-*
data/audit.jsonl*
data/*.log
*.sqlite
*.sqlite3

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# --- Node / frontend build ---
node_modules/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
data/*.json

# --- Build + user-generated artifacts (never committed) ---
build/
dist/
*.spec
datasets/market/
models/default-*
models/*-market-*
adaptive_models/*-live-*

# Local-only project docs (directives/reports/handoff) — never committed
_docs/

# Models are shippable (only DATA is restricted). The public fixture and the
# bundled reference model(s) are tracked; rejected/experiment and live-adaptive
# artifacts stay local-only.
models/default-*
models/*-market-*

# ============================================================
# PRIVATE local-only assets — NEVER publish (see PRIVATE-DATA-NOTICE.md)
# ============================================================
# NOTE: as of v2.0 the licensed market-seed datasets ship publicly on purpose
# (see restricted-folders-guard.yml); they are intentionally NOT ignored here.
private_assets/
data/*
!data/.gitkeep
# Private trained-model handover envelope
PRIVATE_MODEL_MANIFEST.sha256
PRIVATE_MODEL_NOTICE.txt
# Local-only working notes
handoff/
development/
# The FinCompass-Trained integration source folder (deleted after integration)
FinCompass-Trained/

# Revised-docs staging folder (cataloged into paper/; delete after)
FinCompass-Revised-Production-Ready/

# Local-only director-cycle notes/reports — never committed (no AI attribution in repo)
/DIRECTIVE-*.md
/*-IMPLEMENTATION-REPORT.md
/FINCOMPASS_DIRECTOR_*.md
/ENGINEERING_CHECKPOINT.md
/D-[0-9]*.md
/R-[0-9]*.md

# All director-cycle directives/reports/audits — local only, never committed
/local-notes/

# v2.0 source drop (delta source only — never committed)
FinCompass-v2.0/

# local scratch build/run logs
scratch_*.log

# LaTeX build intermediates (regenerated from .tex; never tracked).
# A self-contained arXiv submission keeps its own main.bbl under */arxiv/.
*.aux
*.log
*.out
*.toc
*.bcf
*.blg
*.run.xml
*.synctex.gz
paper/**/*.bbl
docs/**/*.bbl
!**/arxiv/*.bbl

# Canonical documentation source package (draw from selectively; not committed wholesale)
FinCompass-Canonical-Documentation-Production/

# Director handoff bundle — merged then deleted; never tracked
FinCompass-Complete-Documentation-and-Implementation-Handoff/

# Cloud hosting setup bundle — applied as an overlay, then deleted
FinCompass-Cloud-Run-Firebase-Setup/
