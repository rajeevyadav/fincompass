# Optional fundamentals providers. Never commit real keys.
FMP_API_KEY=
ALPHA_VANTAGE_KEY=

# Optional macro/commodity context from FRED.
FRED_API_KEY=

# Shared rate limiter on one host is SQLite by default.
# For multiple hosts: set redis and install requirements-scale.txt.
RATE_LIMIT_BACKEND=sqlite
REDIS_URL=

# Background refresh ownership becomes reclaimable after this many minutes
# without an update (minimum enforced: 5).
SCREENER_JOB_STALE_MINUTES=30

# Audit privacy: hash (default), raw, or none.
AUDIT_IP_MODE=hash
# Rotate current JSONL audit file around this size; one previous file retained.
AUDIT_LOG_MAX_BYTES=5000000

# SEC requires an identifying User-Agent with contact information for CompanyFacts historical features.
SEC_USER_AGENT=

# Forecast registry is local by default. Build/train tools write to ./models.

# SEC public-data hygiene: cache historical CompanyFacts and stay below SEC fair-access limits.
SEC_CACHE_MAX_AGE_HOURS=24
SEC_MAX_REQUESTS_PER_SECOND=8

# Optional authenticated operator event ingest. Leave empty to disable.
FINCOMPASS_EVENT_INGEST_TOKEN=
